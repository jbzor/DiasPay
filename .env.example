# Variables d’environnement — exemple sans aucun secret. Les vraies valeurs vont dans des fichiers .env.local
# (ignorés par Git) et dans les secrets EAS pour les builds. Voir docs/supabase-setup.md.
#
# ── Application : apps/mobile/.env.local ─────────────────────────────────────────────────────────────
# Expo ne lit que les fichiers .env du dossier de l’application. Ces valeurs sont publiques
# (incluses dans l’application) : jamais de clé service_role ici ni dans une variable EXPO_PUBLIC_*.

# Implémentation de l’API : mock (simulateur en mémoire, défaut) ou supabase.
EXPO_PUBLIC_API=mock
# Projet Supabase : Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# Clé publique (« publishable » ou anon) : protégée par les règles RLS côté serveur.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Outils de démonstration (jamais en production : voir docs/release-checklist.md).
# EXPO_PUBLIC_DEMO=1
# EXPO_PUBLIC_ALLOW_DEMO_IN_RELEASE=1
# EXPO_PUBLIC_UPLOAD_FAILURE_RATE=0
# EXPO_PUBLIC_HELP_URL=
# EXPO_PUBLIC_TERMS_URL=

# ── Outils (CLI Supabase, scripts/db.sh) : .env.local à la racine du dépôt ──────────────────────────
# SECRETS : jamais dans le dépôt, jamais dans l’application.
# Jeton d’accès personnel du compte propriétaire du projet (Account > Access Tokens).
SUPABASE_ACCESS_TOKEN=
# Mot de passe de la base (Project Settings > Database).
SUPABASE_DB_PASSWORD=

# Tests de contrat contre un vrai projet (facultatif ; sinon la suite ne tourne que contre le simulateur).
# SUPABASE_TEST_URL=https://<ref>.supabase.co
# SUPABASE_TEST_ANON_KEY=sb_publishable_xxx
