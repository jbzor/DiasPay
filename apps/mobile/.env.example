# Application mobile : variables attendues. Copier ce fichier en apps/mobile/.env.local (ignoré par Git) et le compléter.
# Aucune valeur secrète : ces variables sont publiques (incluses dans l’application). Jamais de clé service_role ici.
# Sans configuration complète, l’application affiche « Configuration manquante » (lot A).

# Serveur : supabase (fonctionnement normal). « mock » (simulateur sur l’appareil, données de démonstration) seulement
# pour les tests et la démonstration, et toujours écrit explicitement.
EXPO_PUBLIC_API=supabase
# Projet Supabase de développement : Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# Clé publique (« publishable » ou anon), protégée par les règles RLS du serveur.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Outils de démonstration (jamais en production : voir docs/release-checklist.md).
# EXPO_PUBLIC_DEMO=1
# EXPO_PUBLIC_ALLOW_DEMO_IN_RELEASE=1
# EXPO_PUBLIC_UPLOAD_FAILURE_RATE=0
# EXPO_PUBLIC_HELP_URL=
# EXPO_PUBLIC_TERMS_URL=
