# Bureau de contrôle (Next.js). Copier en .env.local (jamais versionné).
# Seules la clé publique (publishable / anon) et l’URL du projet sont permises ici : jamais la clé service_role.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Tests de bout en bout (Playwright) : mot de passe des comptes du personnel de test (supabase/seed-staff.sql).
E2E_STAFF_PASSWORD=
